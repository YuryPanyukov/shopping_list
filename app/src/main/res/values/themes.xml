<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.
         Единая фирменная палитра Material 3 (сид — зелёный иконки запуска).
         На Android 12+ цвета подменяются динамическими (Material You) в MainActivity. -->
    <style name="Base.Theme.Shopping_list" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorOnPrimary">@color/brand_on_primary_light</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container_light</item>
        <item name="colorSecondary">@color/brand_secondary_light</item>
        <item name="colorOnSecondary">@color/brand_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container_light</item>
        <item name="colorTertiary">@color/brand_tertiary_light</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary_light</item>
        <item name="colorTertiaryContainer">@color/brand_tertiary_container_light</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container_light</item>
        <item name="colorError">@color/brand_error_light</item>
        <item name="colorOnError">@color/brand_on_error_light</item>
        <item name="colorErrorContainer">@color/brand_error_container_light</item>
        <item name="colorOnErrorContainer">@color/brand_on_error_container_light</item>
    </style>

    <style name="Theme.Shopping_list" parent="Base.Theme.Shopping_list" />
</resources>
